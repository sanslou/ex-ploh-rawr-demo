    waitSeconds: 0
    targetAlpha: 0
    fadeDuration: 0
    targetCamera: {fileID: 0}
    onActionInvoked:
      m_PersistentCalls:
        m_Calls: []
  - actionType: 0
    characterTarget: 0
    npc: {fileID: 1055329292}
    dialogue: "Leaving so soon? May I come along? I\u2019m Sam, by the way!"
    autoAdvanceDialogue: 0
    speakerTarget: 1
