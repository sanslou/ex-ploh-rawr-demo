        m_Calls: []
  - actionType: 7
    characterTarget: 1
    npc: {fileID: 0}
    dialogue: '* Feeling motivated, you got up from the tree stump you''re sitting
      on.'
    autoAdvanceDialogue: 0
    speakerTarget: 1
    speakerNPC: {fileID: 0}
    voiceLine: {fileID: 0}
    voiceVolume: 1
