  - actionType: 0
    characterTarget: 0
    npc: {fileID: 1055329292}
    dialogue: Unsure on what to prove, but uhm, but I'm sure there is something to
      this village.
    autoAdvanceDialogue: 0
    speakerTarget: 0
    speakerNPC: {fileID: 0}
    voiceLine: {fileID: 8300000, guid: 9705d581c10625b43a8c7bd225dd6b46, type: 3}
